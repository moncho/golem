# Copy only the values you need to .env; environment variables take precedence.
GOLEM_PROVIDER=openai
GOLEM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# GOLEM_ROUTER_MODEL=another-model-in-the-same-provider-catalog
# Herma shared memory: the server URL enables it. The project comes from the
# workspace's .herma-project.json binding; this key overrides it.
# GOLEM_HERMA_URL=https://herma.example
# GOLEM_HERMA_IDENTITY=agent-identity-in-credentials.json
# GOLEM_HERMA_PROJECT=rec_existing_project_id
# GOLEM_API_KEY=optional-override-for-the-selected-provider

# Other native providers: anthropic / deepseek, with a Pi catalog model name.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Custom Chat Completions endpoint:
# GOLEM_PROVIDER=compatible
# GOLEM_BASE_URL=https://your-provider.example/v1
# GOLEM_MODEL=your-model
# GOLEM_API_KEY=

# Optional Slack adapter (also requires --slack).
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# GOLEM_SLACK_USERS=U0123456789
# Optional: the fixed reply to people not on that list ("off" for silence).
# GOLEM_SLACK_REFUSAL=I only take requests from my owner.
# Optional: restrict Golem to these conversations instead of every one the bot is in.
# GOLEM_SLACK_CHANNELS=C0123456789
# GOLEM_SLACK_BOTS=B0123456789

# Optional independent endpoint. It appears as the "remote" environment.
# GOLEM_NODE_URL=http://127.0.0.1:7373
# GOLEM_NODE_TOKEN=
